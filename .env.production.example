# Midaz Go SDK Production Environment Variables
#
# Replace every `<...>` placeholder from your deployment secret/config system.
# Do not commit populated production `.env` files.

MIDAZ_ENVIRONMENT=production

# Production Midaz API URLs. Use HTTPS endpoints from your deployed Midaz stack.
# Two planes: Ledger and Tracer. MIDAZ_BASE_URL is the shared default; set the
# per-plane vars for a split deployment.
# Ledger takes NO version segment (the server versions its paths: /v1/... and
# /v2/...); Tracer keeps /v1 (the server mounts unversioned paths under /v1).
MIDAZ_BASE_URL="https://<midaz-ledger-host>"
MIDAZ_LEDGER_URL="https://<midaz-ledger-host>"
MIDAZ_TRACER_URL="https://<midaz-tracer-host>/v1"
# Optional: X-API-Key for the Tracer plane. Unset = share the Ledger Bearer.
# MIDAZ_TRACER_API_KEY="<tracer-api-key-from-secret-manager>"

# HTTP configuration
MIDAZ_TIMEOUT=60
MIDAZ_DEBUG=false

# Retry configuration
MIDAZ_MAX_RETRIES="3"

# Feature flags
MIDAZ_IDEMPOTENCY=true
MIDAZ_ERROR_EXPOSE_BODY=false

# Access Manager authentication is the production-safe default.
# Anonymous production remains a caller-level SDK decision; this template does
# not encourage it because most production Midaz stacks require authentication.
PLUGIN_AUTH_ENABLED=true
PLUGIN_AUTH_ADDRESS="https://<access-manager-host>"
MIDAZ_CLIENT_ID="<client-id-from-secret-manager>"
MIDAZ_CLIENT_SECRET="<client-secret-from-secret-manager>"

# Keep explicit for config-surface parity; production deployments should keep this false.
# This is the auth-plane (Access Manager) escape hatch.
MIDAZ_ACCESS_MANAGER_ALLOW_INSECURE_HTTP=false

# DATA-PLANE (Ledger / Tracer) plain-HTTP escape hatch, distinct from the
# auth-plane var above. Intended only for cluster-internal *.svc.cluster.local
# targets reached over a controlled mesh; keep false for public-internet deployments.
MIDAZ_ALLOW_INSECURE_HTTP=false
