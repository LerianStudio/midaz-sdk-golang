# Midaz Go SDK Environment Variables
#
# This file is a local-development alias for `.env.local.example` so the
# historical `make set-env` flow stays ergonomic. For production deployments,
# start from `.env.production.example` instead.

# Environment configuration (local, development, production)
MIDAZ_ENVIRONMENT=local

# Local Midaz stack URLs
# The consolidated server exposes two planes: Ledger (:3002) and Tracer (:4020).
# MIDAZ_BASE_URL is the shared default for both planes; the per-plane vars below
# override it.
#
# The two planes version themselves differently, so their base URLs differ in
# shape:
#   - Ledger: NO version segment. The server carries the version in the path
#     (/v1/organizations, /v2/organizations), so the SDK reaches both the v1 and
#     v2 surfaces off one bare base. Adding /v1 here yields /v1/v1/... and 404s.
#   - Tracer: keeps /v1. The server mounts its (unversioned) paths under /v1.
MIDAZ_BASE_URL="http://localhost:3002"
MIDAZ_LEDGER_URL="http://localhost:3002"
MIDAZ_TRACER_URL="http://localhost:4020/v1"
# Optional: authenticate the Tracer plane with an X-API-Key instead of the
# shared Ledger Bearer token. Leave unset to share the Bearer token.
# MIDAZ_TRACER_API_KEY=

# HTTP configuration
MIDAZ_TIMEOUT=30
MIDAZ_DEBUG=false

# Retry configuration read by config.FromEnvironment
MIDAZ_MAX_RETRIES="3"

# Feature flags
MIDAZ_IDEMPOTENCY=true
MIDAZ_ERROR_EXPOSE_BODY=false

# Local Plugin Auth configuration
# Keep disabled only for unsecured local stacks. Production deployments should
# use `.env.production.example`, where Access Manager is enabled by default.
PLUGIN_AUTH_ENABLED=false
PLUGIN_AUTH_ADDRESS=http://localhost:4000
MIDAZ_CLIENT_ID=
MIDAZ_CLIENT_SECRET=

# Allow plain HTTP (instead of HTTPS) when reaching the Access Manager.
# Local development only — leave false in any deployed environment.
MIDAZ_ACCESS_MANAGER_ALLOW_INSECURE_HTTP=false

# Allow plain HTTP (instead of HTTPS) when reaching the Ledger / Tracer plane
# URLs (MIDAZ_LEDGER_URL / MIDAZ_TRACER_URL / MIDAZ_BASE_URL). Intended for
# Kubernetes cluster-internal services reached over the cluster mesh
# (e.g. http://midaz-ledger.<ns>.svc.cluster.local:3000) and dev/test
# deployments behind a controlled network boundary. Loaded before the URL
# env vars so MIDAZ_LEDGER_URL pointing at a *.svc.cluster.local target
# is accepted automatically. Leave false for public-internet deployments.
MIDAZ_ALLOW_INSECURE_HTTP=false

# Example-specific configuration
CONCURRENT_CUSTOMER_TO_MERCHANT_TXS=1000
CONCURRENT_MERCHANT_TO_CUSTOMER_TXS="1000"

# Mass demo generator configuration
DEMO_NON_INTERACTIVE=1
DEMO_AUTH_MODE=anonymous-local
DEMO_TIMEOUT=120
DEMO_ORGS=1
DEMO_LEDGERS_PER_ORG=1
DEMO_ACCOUNTS_PER_LEDGER=10
DEMO_TX_PER_ACCOUNT=5
DEMO_CONCURRENCY=4
DEMO_BATCH_SIZE=10
DEMO_ASSETS=1
DEMO_CREATE_HIERARCHY=true
DEMO_RUN_FLOW=true
DEMO_RUN_BATCH=true
# Runs the V2-only phase after the V1 batch: CRM holders/instruments, a
# fund -> transfer -> hold/commit cycle on /v2/transactions with a FATAL
# balance assertion, fee and billing packages, and a metadata-index cycle.
DEMO_RUN_V2=true
DEMO_ASSET_CODE=USD
DEMO_CHART_GROUP=
DEMO_LOCALE=us
