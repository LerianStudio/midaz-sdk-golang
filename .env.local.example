# Midaz Go SDK Local Development Environment Variables
#
# Safe defaults for an unsecured local Midaz stack. Do not use this template for
# production deployments.

MIDAZ_ENVIRONMENT=local
MIDAZ_USER_AGENT="Midaz-Go-SDK/1.0.0"

# Local Midaz stack URLs
MIDAZ_BASE_URL="http://localhost:3002"
MIDAZ_CRM_URL="http://localhost:4003/v1"
MIDAZ_ONBOARDING_URL="http://localhost:3002/v1"
MIDAZ_TRANSACTION_URL="http://localhost:3002/v1"

# HTTP configuration
MIDAZ_TIMEOUT=30
MIDAZ_DEBUG=false

# Retry configuration
MIDAZ_MAX_RETRIES="3"

# Feature flags
MIDAZ_IDEMPOTENCY=true
MIDAZ_ERROR_EXPOSE_BODY=false

# Local Plugin Auth configuration
# Keep disabled only for unsecured local stacks.
PLUGIN_AUTH_ENABLED=false
PLUGIN_AUTH_ADDRESS=http://localhost:4000
MIDAZ_CLIENT_ID=
MIDAZ_CLIENT_SECRET=

# Observability configuration
# MIDAZ_OTEL_ENDPOINT=http://localhost:4318
# MIDAZ_LOG_LEVEL=info

# Example-specific configuration
CONCURRENT_CUSTOMER_TO_MERCHANT_TXS=1000
CONCURRENT_MERCHANT_TO_CUSTOMER_TXS="1000"

# Mass demo generator configuration
DEMO_NON_INTERACTIVE=1
DEMO_AUTH_MODE=anonymous-local
DEMO_TIMEOUT=120
DEMO_ORGS=1
DEMO_LEDGERS_PER_ORG=1
DEMO_ACCOUNTS_PER_LEDGER=10
DEMO_TX_PER_ACCOUNT=0
DEMO_CONCURRENCY=4
DEMO_BATCH_SIZE=10
DEMO_ASSETS=1
DEMO_CREATE_HIERARCHY=true
DEMO_RUN_FLOW=true
DEMO_RUN_BATCH=false
DEMO_ASSET_CODE=USD
DEMO_CHART_GROUP=
DEMO_LOCALE=us
