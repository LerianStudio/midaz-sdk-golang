# Midaz Go SDK Local Development Environment Variables
#
# Safe defaults for an unsecured local Midaz stack. Do not use this template for
# production deployments.

MIDAZ_ENVIRONMENT=local

# Local Midaz stack URLs — two planes: Ledger (:3002) and Tracer (:4020).
# MIDAZ_BASE_URL is the shared default for both planes.
# Ledger takes NO version segment (the server versions its paths: /v1/... and
# /v2/...); Tracer keeps /v1 (the server mounts unversioned paths under /v1).
MIDAZ_BASE_URL="http://localhost:3002"
MIDAZ_LEDGER_URL="http://localhost:3002"
MIDAZ_TRACER_URL="http://localhost:4020/v1"
# Optional: X-API-Key for the Tracer plane. Unset = share the Ledger Bearer.
# MIDAZ_TRACER_API_KEY=

# HTTP configuration
MIDAZ_TIMEOUT=30
MIDAZ_DEBUG=false

# Retry configuration
MIDAZ_MAX_RETRIES="3"

# Feature flags
MIDAZ_IDEMPOTENCY=true
MIDAZ_ERROR_EXPOSE_BODY=false

# Local Plugin Auth configuration
# Keep disabled only for unsecured local stacks.
PLUGIN_AUTH_ENABLED=false
PLUGIN_AUTH_ADDRESS=http://localhost:4000
MIDAZ_CLIENT_ID=
MIDAZ_CLIENT_SECRET=

# Allow plain HTTP (instead of HTTPS) when reaching the Access Manager (auth plane).
# Local development only.
MIDAZ_ACCESS_MANAGER_ALLOW_INSECURE_HTTP=false

# Allow plain HTTP for the DATA-PLANE URLs (Ledger / Tracer:
# MIDAZ_LEDGER_URL / MIDAZ_TRACER_URL / MIDAZ_BASE_URL). Distinct from
# MIDAZ_ACCESS_MANAGER_ALLOW_INSECURE_HTTP above, which is the auth plane.
# Local development only.
MIDAZ_ALLOW_INSECURE_HTTP=false

# Example-specific configuration
CONCURRENT_CUSTOMER_TO_MERCHANT_TXS=1000
CONCURRENT_MERCHANT_TO_CUSTOMER_TXS="1000"

# Mass demo generator configuration
DEMO_NON_INTERACTIVE=1
DEMO_AUTH_MODE=anonymous-local
DEMO_TIMEOUT=120
DEMO_ORGS=1
DEMO_LEDGERS_PER_ORG=1
DEMO_ACCOUNTS_PER_LEDGER=10
DEMO_TX_PER_ACCOUNT=5
DEMO_CONCURRENCY=4
DEMO_BATCH_SIZE=10
DEMO_ASSETS=1
DEMO_CREATE_HIERARCHY=true
DEMO_RUN_FLOW=true
DEMO_RUN_BATCH=true
# Runs the V2-only phase after the V1 batch: CRM holders/instruments, a
# fund -> transfer -> hold/commit cycle on /v2/transactions with a FATAL
# balance assertion, fee and billing packages, and a metadata-index cycle.
DEMO_RUN_V2=true
DEMO_ASSET_CODE=USD
DEMO_CHART_GROUP=
DEMO_LOCALE=us
